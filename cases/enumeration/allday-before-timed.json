{
    "description": "An enumeration answers in ascending order, an all-day occurrence before a timed one at the same instant",
    "spec": "Evaluation model - enumeration, ordering",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "schedules": [
                {"days": [28], "allday": true},
                {"days": ["tue"], "times": ["00:00"]}
            ]
        },
        "query": {"type": "enumeration", "from": "2026-07-27T12:00:00+09:00", "through": "2026-07-28T12:00:00+09:00"}
    },
    "response": {"result": ["2026-07-28", "2026-07-28T00:00:00+09:00"]}
}

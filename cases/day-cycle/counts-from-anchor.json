{
    "description": "The day cycle counts the from date as day one - every 2 days anchored 7/14 fires on the 14th, 16th, 18th",
    "spec": "The day-cycle tuple - every Nth day counting the from date as day one",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "schedules": [
                {"from": "2026-07-14 00:00", "days": [["every", 2, "day"]], "times": ["03:00"]}
            ]
        },
        "query": {"type": "enumeration", "from": "2026-07-14T00:00:00+09:00", "through": "2026-07-19T00:00:00+09:00"}
    },
    "response": {"result": ["2026-07-14T03:00:00+09:00", "2026-07-16T03:00:00+09:00", "2026-07-18T03:00:00+09:00"]}
}

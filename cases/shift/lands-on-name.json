{
    "description": "A landing condition can be any day atom, including a name - the 25th moves back to the previous day in the named date set",
    "spec": "shift - the landing condition is a day atom (a name works)",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "calendar": {
                "date_sets": {"open-days": ["2026-04-24"]}
            },
            "schedules": [
                {"months": [4], "days": [25], "shift": ["prev", "open-days"], "times": ["10:00"]}
            ]
        },
        "query": {"type": "point", "at": "2026-04-24T10:00:00+09:00"}
    },
    "response": {"result": true}
}

{
    "description": "A household calendar - the anniversary morning holds the all-day occurrence and the 8:00 medication dose, the day preceding the points within it",
    "spec": "Examples - a realistic household document (all-day and timed staying distinct in one answer)",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "calendar": {
                "holidays": ["2026-01-01", "2026-05-05", "2026-07-20"],
                "date_sets": {"anniversary": ["2026-06-10"]}
            },
            "schedules": [
                {"days": [["1st", "tue"], ["3rd", "tue"]], "if": ["not", "holiday"], "times": ["07:30"]},
                {"from": "2026-05-01 00:00", "days": [["every", 2, "day"]], "times": ["08:00", "20:00"]},
                {"days": ["anniversary"], "allday": true},
                {"days": ["sun"], "times": ["10:00"]}
            ]
        },
        "query": {"type": "enumeration", "from": "2026-06-10T00:00:00+09:00", "through": "2026-06-10T12:00:00+09:00"}
    },
    "response": {"result": ["2026-06-10", "2026-06-10T08:00:00+09:00"]}
}

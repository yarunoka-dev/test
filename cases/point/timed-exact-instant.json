{
    "description": "A timed occurrence matches its exact instant",
    "spec": "Evaluation model - judgment at a point",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "schedules": [
                {"days": ["mon"], "times": ["10:00"]}
            ]
        },
        "query": {"type": "point", "at": "2026-07-27T10:00:00+09:00"}
    },
    "response": {"result": true}
}

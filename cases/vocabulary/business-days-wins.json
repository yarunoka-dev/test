{
    "description": "A day in business_days is a business day even when it is also a holiday - the top layer overrides everything below",
    "spec": "Calendar vocabulary - the decision procedure, business_days wins",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "calendar": {
                "holidays": ["2026-01-01"],
                "business_holidays": [],
                "business_days": ["2026-01-01"]
            },
            "schedules": [
                {"days": ["business_day"], "times": ["09:00"]}
            ]
        },
        "query": {"type": "point", "at": "2026-01-01T09:00:00+09:00"}
    },
    "response": {"result": true}
}

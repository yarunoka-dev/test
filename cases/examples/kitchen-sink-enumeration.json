{
    "description": "An overloaded but valid document - every construct at once, enumerated over the first days of January with the New Year all-day occurrence preceding the timed point at the same instant",
    "spec": "Examples - an excessive but valid document (the whole language in one document)",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "resolvers": ["company-closures"],
            "calendar": {
                "holidays": ["2026-01-01", "2026-07-20"],
                "business_holidays": "company-closures",
                "business_days": ["2026-01-04"],
                "workweek": ["mon", "tue", "wed", "thu", "fri"],
                "business_hours": [["09:00", "12:00"], ["13:00", "18:00"]],
                "date_sets": {
                    "founding-day": ["2026-10-01"],
                    "audit-days": ["2026-03-31", "2026-09-30"]
                }
            },
            "schedules": [
                {"days": [25], "shift": ["prev", "or_same", "business_day"], "times": ["10:00"]},
                {"days": ["mon"], "if": ["not", "holiday"], "times": {"every": [2, "hour"], "between": "business_hour"}},
                {"days": ["audit-days"], "allday": true},
                {"days": ["founding-day"], "allday": true},
                {"from": "2026-01-05 00:00", "days": [["every", 2, "day"]], "times": ["07:00"]},
                {"from": "2026-01-01 00:00", "until": "2026-02-01 00:00", "every": [36, "hour"]},
                {"days": [["1st", "mon"], ["3rd", "mon"]], "times": ["08:30"]},
                {"if": ["next", "last_day_of_month"], "times": ["23:30"]},
                {"days": ["weekend"], "times": ["11:00"]},
                {"days": ["holiday"], "allday": true}
            ]
        },
        "query": {"type": "enumeration", "from": "2026-01-01T00:00:00+09:00", "through": "2026-01-06T00:00:00+09:00"},
        "bindings": {"company-closures": ["2026-01-02", "2026-01-03"]}
    },
    "response": {"result": [
        "2026-01-01",
        "2026-01-01T00:00:00+09:00",
        "2026-01-02T12:00:00+09:00",
        "2026-01-03T11:00:00+09:00",
        "2026-01-04T00:00:00+09:00",
        "2026-01-04T11:00:00+09:00",
        "2026-01-05T07:00:00+09:00",
        "2026-01-05T08:30:00+09:00",
        "2026-01-05T09:00:00+09:00",
        "2026-01-05T11:00:00+09:00",
        "2026-01-05T12:00:00+09:00",
        "2026-01-05T13:00:00+09:00",
        "2026-01-05T15:00:00+09:00",
        "2026-01-05T17:00:00+09:00"
    ]}
}

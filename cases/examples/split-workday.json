{
    "description": "The spec example: 8:00 on working days, 10:00 on days off - two complete schedules in one document, the Saturday firing at 10:00",
    "spec": "Examples - the two-schedule value of schedules",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "calendar": {
                "holidays": ["2026-07-20"],
                "business_holidays": [],
                "business_days": []
            },
            "schedules": [
                {"days": ["business_day"], "times": ["08:00"]},
                {"days": ["business_holiday"], "times": ["10:00"]}
            ]
        },
        "query": {"type": "point", "at": "2026-07-04T10:00:00+09:00"}
    },
    "response": {"result": true}
}

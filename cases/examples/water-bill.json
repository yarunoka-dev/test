{
    "description": "The spec example: the water bill on the 27th of even months, moved to the next business day on days off - the Saturday June 27th bills on Monday the 29th",
    "spec": "Examples - the water bill",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "calendar": {
                "holidays": [],
                "business_holidays": [],
                "business_days": []
            },
            "schedules": [
                {"months": [2, 4, 6, 8, 10, 12], "days": [27], "shift": ["next", "or_same", "business_day"], "times": ["09:00"]}
            ]
        },
        "query": {"type": "point", "at": "2026-06-29T09:00:00+09:00"}
    },
    "response": {"result": true}
}

{
    "description": "The spec example: every 600 seconds - a whole-day second grid",
    "spec": "Examples - every 600 seconds",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "schedules": [
                {"times": {"every": [600, "second"]}}
            ]
        },
        "query": {"type": "point", "at": "2026-07-15T00:10:00+09:00"}
    },
    "response": {"result": true}
}

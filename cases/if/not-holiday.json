{
    "description": "if with not filters out matching days without moving anything - a Monday holiday produces no occurrence",
    "spec": "if - the not form filters without moving",
    "request": {
        "action": "eval",
        "document": {
            "version": "1.0",
            "timezone": "Asia/Tokyo",
            "calendar": {
                "holidays": ["2026-07-20"]
            },
            "schedules": [
                {"days": ["mon"], "if": ["not", "holiday"], "times": ["09:00"]}
            ]
        },
        "query": {"type": "point", "at": "2026-07-20T09:00:00+09:00"}
    },
    "response": {"result": false}
}
